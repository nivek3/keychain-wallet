PRODUCT_NAME = KeychainWallet
PRODUCT_BUNDLE_IDENTIFIER = dev.phcxc.KeychainWallet.a15e8e
MACOSX_DEPLOYMENT_TARGET = 14.0
SWIFT_VERSION = 5.0
SWIFT_OBJC_BRIDGING_HEADER = $(SRCROOT)/include/WalletCrypto.h
SWIFT_OPTIMIZATION_LEVEL = -O
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = Info.plist
INFOPLIST_EXPAND_BUILD_SETTINGS = YES
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = Apple Development
CODE_SIGN_ENTITLEMENTS = KeychainWallet.entitlements
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO
ENABLE_HARDENED_RUNTIME = YES
ENABLE_APP_SANDBOX = NO
ENABLE_DEBUG_DYLIB = NO
ENABLE_TESTABILITY = NO
// Cargo manages its own registry and build cache; this affects build scripts only.
ENABLE_USER_SCRIPT_SANDBOXING = NO
// shortcut: native Mac architecture only; add cross compilation before distributing universal builds.
ARCHS = $(NATIVE_ARCH_ACTUAL)
ONLY_ACTIVE_ARCH = YES
LIBRARY_SEARCH_PATHS = $(inherited) "$(BUILT_PRODUCTS_DIR)"
OTHER_LDFLAGS = $(inherited) -lwallet_crypto -liconv -lresolv
