{
  "name": "macos-keychain-wallet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README_ZH.md"
  ],
  "scripts": {
    "build": "npm run build:bridge && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.check.json",
    "test": "node --import tsx --test test/*.test.ts",
    "build:bridge": "bash scripts/build-bridge.sh"
  },
  "overrides": {
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "viem": "^2.0.0",
    "ethers-v5": "npm:ethers@^5.7.2",
    "ethers-v6": "npm:ethers@^6.0.0"
  }
}
